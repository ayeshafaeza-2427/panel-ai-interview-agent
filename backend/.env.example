# ── AI Provider (required) ───────────────────────────────────────────────
# The app speaks the OpenAI-compatible chat-completions format, so any
# provider using that wire format works by just changing these values -
# no code changes needed.
#
# Default: Google Gemini, via its official OpenAI-compatible API
# (https://ai.google.dev/gemini-api/docs/openai). Genuinely free tier,
# no credit card required.
#   1. Go to https://aistudio.google.com/apikey
#   2. Create an API key
#   3. Paste it below as GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# AI_PROVIDER selects a preset (fills in AI_BASE_URL/AI_MODEL/the expected
# key variable below if you don't set them explicitly). Supported presets:
# gemini, openai.
AI_PROVIDER=gemini

# Optional overrides - set these to use a provider that isn't one of the
# presets above (Groq, Together AI, Fireworks, OpenRouter, a local
# Ollama/vLLM server, OpenAI directly, etc). If set, these always win over
# the preset. If you use a provider outside the presets, also set the
# generic AI_API_KEY (instead of/in addition to GEMINI_API_KEY) since
# only known presets get a dedicated key variable.
# AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.6-flash

AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# ── App config ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
